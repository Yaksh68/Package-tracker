# Packages Tracker configuration. Copy to `.env` (next to this file, or in
# backend/) and fill in what you need. `.env` is git-ignored: real tokens and
# passwords go there, never in this file.

# --- Database (required) ----------------------------------------------------
# Postgres for deploy/postgres-compose.yml. DATABASE_URL must use the same password.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://packages:change-me@127.0.0.1:5432/packages_tracker

# --- Mode ---------------------------------------------------------------------
# none   = no login: everything runs as the built-in local user and workspace.
# github = public multi-user mode: Sign in with GitHub, workspaces, per-workspace
#          keys, and stricter clone and Docker rules.
AUTH_MODE=none

# Encrypts stored keys and tokens. Required when AUTH_MODE=github; generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, a local install generates data/secret.key (keep that file safe).
APP_SECRET_KEY=
# While rotating, put the old key here so existing values still decrypt.
APP_SECRET_KEY_PREVIOUS=

# --- Public mode (AUTH_MODE=github) ------------------------------------------------
# Where the app is reached. The GitHub OAuth app's callback URL must be
# PUBLIC_BASE_URL/api/auth/github/callback. https:// turns on Secure cookies.
PUBLIC_BASE_URL=http://localhost:5173
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# GitHub logins with platform-admin rights, comma-separated.
PLATFORM_ADMINS=
MAX_USERS=50
SESSION_DAYS=30
# Who runs this service: shown on the privacy policy and terms pages.
# Requests a minute (public mode): sign-in per address, API calls per session,
# per address, and per address without a session.
RATE_LIMIT_SIGNIN=10
RATE_LIMIT_SESSION=300
RATE_LIMIT_ADDRESS=600
RATE_LIMIT_ANONYMOUS=60
OPERATOR_NAME=
CONTACT_EMAIL=

# --- Git access ---------------------------------------------------------------
# Read-only personal access tokens, injected into clone URLs at runtime.
# They are never stored in snapshots or logs.
GITLAB_TOKEN=
GITHUB_TOKEN=
# Optional: raises the GitHub API rate limit for EOL lookups (falls back to GITHUB_TOKEN).
GITHUB_API_TOKEN=

# Hosts that repos may be cloned from, comma-separated. A `*.example.com` entry
# allows that domain's subdomains. Empty means any host (AUTH_MODE=none only).
# With AUTH_MODE=github, it defaults to github.com,gitlab.com,bitbucket.org,codeberg.org.
GIT_HOST_ALLOWLIST=
# Stops a clone that takes longer than this many seconds.
CLONE_TIMEOUT_SECONDS=120
# Scans that run at once; in the public mode a workspace runs one at a time.
SCAN_WORKERS=2
# Package lookups one scan runs at a time.
LOOKUP_CONCURRENCY=6

# --- Docker image inventory -----------------------------------------------------
# auto = use Docker when it's available, otherwise skip quietly (no "degraded" scan)
# on   = always try (a missing Docker marks the scan degraded)
# off  = never use Docker
# It's always off when AUTH_MODE=github.
IMAGE_INSPECT=auto

# --- AI research (optional; scans work without it) -------------------------------
# Who researches ambiguous packages:
#   (unset)            the Claude Code CLI and this machine's login (local mode only)
#   anthropic          the Anthropic API with AI_API_KEY (default model claude-haiku-5-5)
#   openai | gemini | groq | openrouter
#                      that provider's OpenAI-compatible API with AI_API_KEY and AI_MODEL,
#                      plus SEARCH_PROVIDER/SEARCH_API_KEY (no built-in web search)
#   openai-compatible  any other OpenAI-compatible API at AI_BASE_URL
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
# tavily (1,000 free searches a month) or exa
SEARCH_PROVIDER=
SEARCH_API_KEY=
AI_MAX_TOOL_ROUNDS=8

# The Claude CLI provider (when AI_PROVIDER is unset)
CLAUDE_CLI_PATH=
AGENT_BACKEND=subprocess
AGENT_MODEL=claude-haiku-4-5-20251001
USE_ENRICHMENT_AGENT=true
USE_EXTRACTION_AGENT=false
WEB_SEARCH_MAX_USES=5
ENRICHMENT_BATCH_SIZE=18
# Reuse an AI finding for the same package version from the last N days' scans (0 = always research).
AI_REUSE_DAYS=7

# --- Uploads and caches -------------------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=200
UPLOAD_MAX_UNPACKED_MB=2048
UPLOAD_MAX_FILES=100000
APT_INDEX_CACHE_DIR=cache/apt-index

# --- Flags ------------------------------------------------------------------------------
EOL_SOON_MONTHS=6
STALE_YEARS=2

# --- Legacy file storage (read only by `python -m app.import_files`) ----------------
EOL_DATA_DIR=./data
