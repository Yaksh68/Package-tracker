# Settings for the cloud deployment (deploy/compose.cloud.yml).
#   cp deploy/.env.cloud.example deploy/.env.cloud && chmod 600 deploy/.env.cloud
# Then fill it in. deploy/.env.cloud is never committed (.gitignore).

# --- Where the site lives --------------------------------------------------------
# The hostname only, e.g. packages-tracker.duckdns.org (no https://, no slash).
DOMAIN=
# For the HTTPS certificate account (Let's Encrypt): your email address.
ACME_EMAIL=

# --- Secrets: generate each one, and keep copies in a password manager -----------
# Encrypts the AI keys and git tokens users save. Without it, a database backup
# can't be read back, so store it apart from the backups. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# While rotating APP_SECRET_KEY, the old key goes here for a while.
APP_SECRET_KEY_PREVIOUS=
# The database password (letters and digits only, so it's safe in a URL):
#   python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# --- Sign in with GitHub ------------------------------------------------------------
# A GitHub OAuth app whose callback URL is https://<DOMAIN>/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# GitHub usernames with platform-admin rights, comma-separated.
PLATFORM_ADMINS=
# The sign-up cap.
MAX_USERS=50

# --- Who runs it (shown on the privacy policy and terms pages) ---------------------
OPERATOR_NAME=
CONTACT_EMAIL=

# --- Tuning (the defaults suit a 4-core, 24 GB A1 VM) -------------------------------
SCAN_WORKERS=2
LOOKUP_CONCURRENCY=6

# --- Free scans without an account (optional) ----------------------------------------
# GitHub lookups during a visitor's free scan, when they give no token of their
# own. Without one, GitHub allows the whole server 60 lookups an hour, which
# busy free scans run out of. A GitHub token with no permissions at all is
# enough (it only reads public data): github.com → Settings → Developer
# settings → Fine-grained tokens, with "Public repositories (read-only)".
TRIAL_GITHUB_TOKEN=
